{
  "name": "lemon-templates-api",
  "version": "5.26.1030",
  "description": "lemon-templates management api",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "port": 8800,
  "scripts": {
    "!build": "------ build /src to /dist ----",
    "build": "npm run fields:gen && npm run build-ts",
    "build-ts": "ttsc",
    "watch-ts": "ttsc -w",
    "fields:migrate": "lemon-fields migrate --report --update-tsconfig",
    "fields:gen": "lemon-fields gen",
    "fields:report": "lemon-fields gen --report",
    "fields:check": "lemon-fields --check",
    "fields:types": "lemon-fields-types",
    "nodemon": "nodemon --config nodemon-main.json",
    "lint": "tsc --noEmit && eslint '*/**/*.{js,ts,jsx,tsx}' --fix",
    "!start": "------ run in local development (note! ts-node seems not watch '.js' file) ----",
    "*start": "nodemon --watch src --exec ts-node --compiler typescript -r tsconfig-paths/register src/index.ts",
    "start": "npm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"cyan.bold,green.bold\" \"npm run watch-ts\" \"npm run nodemon\"",
    "!express": "---- 로컬/개발 서버에서 express로 안정적으로 돌리기 위함 (express.lemon: 자기 서비스 SNS/SQS/protocol을 프로세스 안에서 전달, .aws: 실제 AWS) -----",
    "express.lemon": "ENV=lemon STAGE=local LOCAL_TRANSPORT=mock npm run start",
    "express.lemon.aws": "ENV=lemon STAGE=local npm run start",
    "!deploy": "-----  빌드후 dist 폴더에 압축한 다음, serverless를 통해서 deploy 실행 -----",
    "deploy.lemon-vpc": "npm run build && sls deploy --param='profile=lemon' --stage dev --config serverless-vpc.yml",
    "deploy.lemon": "npm run build && sls deploy --param='profile=lemon' --stage dev",
    "deploy.lemon.prod": "npm run build && sls deploy --param='profile=lemon' --stage prod",
    "!info": "------- print sls infor by profile -----",
    "info": "sls info --stage prod",
    "info.lemon": "sls info --param='profile=lemon' --stage dev",
    "info.lemon.prod": "sls info --param='profile=lemon' --stage prod",
    "!pack": "------- gulp 빌드후 dist 폴더에 압축한 다음, serverless를 통해서 deploy 실행 -----",
    "pack.lemon": "npm run build && sls package --param='profile=lemon' --stage dev",
    "pack.lemon.prod": "npm run build && sls package --param='profile=lemon' --stage prod",
    "!logs": "------- print logs of serverless by profile -----",
    "logs": "sls logs --stage prod -t --startTime 5m -f hello",
    "logs.lemon": "sls logs --param='profile=lemon' --stage dev -t --startTime 5m -f lambda",
    "logs.lemon.prod": "sls logs --param='profile=lemon' --stage prod -t --startTime 5m -f lambda",
    "!lambda": "------- invoke the deployed lambda / watch its logs (bin/) -----",
    "lambda:invoke": "node bin/lambda-invoke.mjs",
    "lambda:logs": "node bin/lambda-logs.mjs",
    "lambda:test": "node --test bin/lib/*.test.mjs",
    "perf:lambda": "node bin/perf-lambda.mjs",
    "fields:admin": "node bin/fields-admin.mjs",
    "loop:check": "node bin/loop-check.mjs",
    "!remove": "----- sls remove by profile -----",
    "remove": "sls remove --stage prod",
    "remove.lemon": "sls remove --param='profile=lemon' --stage dev",
    "remove.lemon.prod": "sls remove --param='profile=lemon' --stage prod",
    "!test": "------- run self-test with jest -----",
    "test": "npm run fields:gen && LS=1 jest --config=jest.config.json",
    "test:dev": "npm run fields:gen && LS=1 jest --config=jest.config.json --watchAll",
    "test:watch": "npm run fields:gen && LS=1 AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 jest --config=jest.config.json --watchAll",
    "test:watch.lemon": "ENV=lemon npm run test:watch",
    "!types": "------- make types package -----",
    "prepretypes": "LS=1 ts-node @types/bin/init-package.ts",
    "pretypes": "rm -rf ./@types/dist && npm run prepretypes",
    "types": "ttsc -p ./@types/tsconfig.build.json",
    "posttypes": "npm publish --dry-run ./@types"
  },
  "author": "Steve Jung (steve@lemoncloud.io)",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-iam": "^3.971.0",
    "@aws-sdk/client-kms": "^3.971.0",
    "@aws-sdk/client-lambda": "^3.971.0",
    "@aws-sdk/client-s3": "^3.971.0",
    "@aws-sdk/client-sns": "^3.971.0",
    "@aws-sdk/client-sqs": "^3.971.0",
    "@aws-sdk/client-sts": "^3.971.0",
    "@aws-sdk/credential-providers": "^3.971.0",
    "lemon-core": "^5.0.11"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.971.0",
    "@cruglobal/serverless-merge-config": "^1.1.0",
    "@types/cors": "^2.8.7",
    "@types/jest": "^27.5.0",
    "@types/request": "^2.48.5",
    "@types/supertest": "^2.0.10",
    "@types/uuid": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "^5.22.0",
    "@typescript-eslint/parser": "^5.22.0",
    "codecov": "^3.7.2",
    "concurrently": "^5.3.0",
    "eslint": "^8.14.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^27.5.1",
    "lemon-devkit": "^0.2.2",
    "lint-staged": "^13.1.0",
    "nodemon": "^2.0.18",
    "prettier": "^2.6.2",
    "serverless": "^3.19.0",
    "serverless-aws-documentation": "^0.8.0",
    "serverless-plugin-log-retention": "^2.0.0",
    "serverless-prune-plugin": "^2.0.1",
    "superagent": "^5.3.1",
    "supertest": "^4.0.2",
    "ts-jest": "^27.1.5",
    "ts-node": "^8.1.0",
    "tsconfig-paths": "^4.1.2",
    "ttypescript": "^1.5.15",
    "typescript": "^4.7.4"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "lemoncloud",
    "serverless"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:lemoncloud-io/lemon-templates-api.git"
  }
}
