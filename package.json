{
  "name": "lemon-templates-api",
  "version": "5.26.1030",
  "description": "lemon-templates management api",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "port": 8800,
  "scripts": {
    "!build": "------ build /src to /dist ----",
    "build": "npm run build-ts",
    "build-ts": "ttsc",
    "watch-ts": "ttsc -w",
    "fields:types": "lemon-fields-types",
    "nodemon": "nodemon --config nodemon-main.json",
    "lint": "tsc --noEmit && eslint '*/**/*.{js,ts,jsx,tsx}' --fix",
    "!start": "------ run in local development (note! ts-node seems not watch '.js' file) ----",
    "*start": "nodemon --watch src --exec ts-node --compiler typescript -r tsconfig-paths/register src/index.ts",
    "start": "npm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"cyan.bold,green.bold\" \"npm run watch-ts\" \"npm run nodemon\"",
    "!express": "---- 로컬/개발 서버에서 express로 안정적으로 돌리기 위함 (express.lemon: 자기 서비스 SNS/SQS/protocol을 프로세스 안에서 전달, .aws: 실제 AWS) -----",
    "express.lemon": "ENV=lemon STAGE=local LOCAL_TRANSPORT=mock npm run start",
    "express.lemon.aws": "ENV=lemon STAGE=local npm run start",
    "pack": "lemon-lambda-pack",
    "!lambda": "------- Lambda tools of lemon-core (lemon-* bins): invoke / logs / perf / fields-admin / loop-check -----",
    "lambda:invoke": "lemon-lambda-invoke",
    "lambda:logs": "lemon-lambda-logs",
    "perf:lambda": "lemon-lambda-perf",
    "fields:admin": "lemon-fields-admin",
    "loop:check": "lemon-loop-check",
    "!test": "------- run self-test with jest -----",
    "test": "LS=1 jest --config=jest.config.json",
    "test:dev": "LS=1 jest --config=jest.config.json --watchAll",
    "test:watch": "LS=1 AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 jest --config=jest.config.json --watchAll",
    "test:watch.lemon": "ENV=lemon npm run test:watch",
    "!types": "------- make types package -----",
    "prepretypes": "LS=1 ts-node @types/bin/init-package.ts",
    "pretypes": "rm -rf ./@types/dist && npm run prepretypes",
    "types": "ttsc -p ./@types/tsconfig.build.json",
    "posttypes": "npm publish --dry-run ./@types",
    "lambda:local": "lemon-lambda-local",
    "bundle:lab": "npm --prefix tools/lambda-bundle run experiment",
    "lambda:deploy": "lemon-lambda-deploy",
    "lambda:migrate": "lemon-lambda-migrate",
    "lambda:deploy:dev": "lemon-lambda-deploy-dev"
  },
  "author": "Steve Jung (steve@lemoncloud.io)",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-iam": "^3.1159.0",
    "@aws-sdk/client-kms": "^3.1159.0",
    "@aws-sdk/client-lambda": "^3.1159.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/client-sns": "^3.1159.0",
    "@aws-sdk/client-sqs": "^3.1159.0",
    "@aws-sdk/client-sts": "^3.1159.0",
    "@aws-sdk/credential-providers": "^3.1159.0",
    "lemon-core": "^5.0.15"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1159.0",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^5.22.0",
    "@typescript-eslint/parser": "^5.22.0",
    "concurrently": "^5.3.0",
    "deepmerge": "file:./scripts/deepmerge-safe",
    "eslint": "^8.14.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^13.1.0",
    "nodemon": "^3.1.14",
    "prettier": "^2.6.2",
    "superagent": "^5.3.1",
    "supertest": "^4.0.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^8.1.0",
    "tsconfig-paths": "^4.1.2",
    "ttypescript": "^1.5.15",
    "typescript": "^4.7.4"
  },
  "overrides": {
    "deepmerge": "$deepmerge"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "lemoncloud",
    "serverless"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:lemoncloud-io/lemon-templates-api.git"
  }
}
