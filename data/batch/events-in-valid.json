{
    "$": "type:events expiredAt가 유효한 것들.",
    "size": 1,
    "query": {
        "bool": {
            "filter": [{
                    "term": {
                        "ns.keyword": "{{ns}}"
                    }
                },
                {
                    "term": {
                        "type.keyword": "event"
                    }
                },
                {
                    "exists": {
                        "field": "identityId"
                    }
                }
            ],
            "must": [{
                "range": {
                    "enabled": { "gt": 0 }
                }
            }]
        }
    },
    "sort": {
        "createdAt": "asc"
    }
}
